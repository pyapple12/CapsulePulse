{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CapsulePulse",
  "identifier": "com.pyapple12.capsule-pulse",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "CapsulePulse",
        "width": 300,
        "height": 400,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "skipTaskbar": true,
        "shadow": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
