{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CapsulePulse",
  "identifier": "com.pyapple12.capsule-pulse",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "CapsulePulse",
        "width": 360,
        "height": 480,
        "resizable": false,
        "transparent": true,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"]
  }
}
